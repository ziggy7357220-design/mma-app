  // ----- Lookups -----
  static Workout? workoutById(String id) {
    for (final w in workouts) {
      if (w.id == id) return w;
    }
    return null;
  }

  static List<Workout> workoutsByArt(String artId) {
    return workouts.where((w) => w.martialArt == artId).toList();
  }

  static List<Workout> workoutsByCategory(String artId, String category) {
    return workouts.where((w) => w.martialArt == artId && w.category == category).toList();
  }

  static List<Workout> workoutsByDifficulty(String artId, String difficulty) {
    return workouts.where((w) => w.martialArt == artId && w.difficulty == difficulty).toList();
  }

  static List<Technique> techniquesForArt(String artId) {
    return techniques[artId] ?? const [];
  }

  static List<Technique> techniquesByCategory(String artId, String category) {
    return techniques[artId]?.where((t) => t.category == category).toList() ?? const [];
  }
